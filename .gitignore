# ============================================
# TrackEase - Git Ignore
# ============================================

# Python environments
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/

# VS Code
.vscode/

# Frontend generated files
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Secrets
.env
.env.*
!.env.example

# Raw/local datasets
data/raw/

# Generated processed datasets
data/processed/*.csv
data/processed/*.jsonl
data/processed/*.parquet

# Keep reports
!data/processed/*.txt
!data/processed/*.md

# Generated ML models
data/models/*.joblib
data/models/*.pkl
data/models/*.pickle

# Temporary files
*.bak
*.bak_*
*.tmp
*.log

# Runtime databases
*.db
*.sqlite
*.sqlite3

# OS files
.DS_Store
Thumbs.db
